# Copy to .dev.vars. Do not commit .dev.vars.
# `bun run dev` and `bun run preview` read this file through the Workers platform proxy.
# `bun run dev` still skips the Turnstile gate. Production does not upload this file:
# set each name with `bunx wrangler secret put`, then `bun run deploy`.
#
# Site key: Cloudflare dashboard → Turnstile → your widget → Site key.
# Secret key: the same widget → Secret key.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public vendor keys those catalogs already ship in their own pages.
PARKER_API_KEY=
BALDWIN_SUBSCRIPTION_KEY=
DONALDSON_SERVICE_TOKEN=
